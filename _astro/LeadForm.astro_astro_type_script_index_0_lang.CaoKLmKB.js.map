  /* טופס → הודעת וואטסאפ מוכנה (או mailto). רץ פעם אחת לכל הטפסים בדף. */
  const forms = document.querySelectorAll<HTMLFormElement>('[data-lead-form]');
  const label = (form: HTMLFormElement, name: string) => {
    const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | RadioNodeList | null;
    return el && 'value' in el ? String(el.value).trim() : '';
  };
  const intentLabel = (form: HTMLFormElement) => {
    const checked = form.querySelector<HTMLInputElement>('input[name="intent"]:checked');
    return checked?.nextElementSibling?.textContent?.trim() ?? '';
  };
  const compose = (form: HTMLFormElement) => {
    const he = form.dataset.locale === 'he';
    const name = label(form, 'name'), phone = label(form, 'phone');
    const hood = label(form, 'neighborhood'), msg = label(form, 'message');
    const optin = (form.elements.namedItem('marketing') as HTMLInputElement | null)?.checked;
    const lines = he
      ? [`שלום, הגעתי מהאתר.`, `שם: ${name}`, `טלפון: ${phone}`, `נושא הפנייה: ${intentLabel(form)}`, hood && `שכונה: ${hood}`, msg && `הודעה: ${msg}`, optin && `אשמח לקבל עדכונים על דירות חדשות`]
      : [`Hi, I found you through the site.`, `Name: ${name}`, `Phone: ${phone}`, `Regarding: ${intentLabel(form)}`, hood && `Neighbourhood: ${hood}`, msg && `Message: ${msg}`, optin && `Happy to receive listing updates`];
    return lines.filter(Boolean).join('\n');
  };
  forms.forEach((form) => {
    const mail = form.querySelector<HTMLAnchorElement>('[data-lead-mail]');
    const syncMail = () => {
      if (!mail) return;
      const subject = form.dataset.locale === 'he' ? 'פנייה מהאתר' : 'Enquiry from the website';
      mail.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(compose(form))}`;
    };
    form.addEventListener('input', syncMail);
    syncMail();
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
