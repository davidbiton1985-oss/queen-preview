  import { spitzer } from './calc-math';
  const form = document.querySelector<HTMLFormElement>('[data-mortgage]');
  if (form) {
    const he = form.dataset.locale === 'he';
    const nf = new Intl.NumberFormat('he-IL', { maximumFractionDigits: 0 });
    const money = (x: number) => (he ? `${nf.format(Math.round(x))} ₪` : `₪${nf.format(Math.round(x))}`);
    const num = (name: string) => {
      const v = (form.elements.namedItem(name) as HTMLInputElement).value.replace(/[^\d.]/g, '');
      return v === '' ? NaN : parseFloat(v);
    };
    const out = (k: string) => form.parentElement!.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const bar = (k: string) => form.parentElement!.querySelector<HTMLElement>(`[data-bar="${k}"]`)!;
    const yearsIn = form.elements.namedItem('years') as HTMLInputElement;
    const yearsOut = form.querySelector<HTMLOutputElement>('[data-years-out]')!;

    const render = () => {
      const years = +yearsIn.value;
      const yl = he ? `${years} שנים` : `${years} years`;
      yearsOut.value = yl; yearsIn.setAttribute('aria-valuetext', yl);
      const r = spitzer(num('amount'), years, num('rate'));
      if (!r) {
        ['monthly', 'interest', 'total', 'n'].forEach((k) => (out(k).textContent = '—'));
        bar('a').style.inlineSize = '0'; bar('b').style.inlineSize = '0';
        return;
      }
      out('monthly').textContent = money(r.monthly);
      out('interest').textContent = money(r.interest);
      out('total').textContent = money(r.total);
      out('n').textContent = nf.format(r.n);
      bar('a').style.inlineSize = `${(100 * num('amount')) / r.total}%`;
      bar('b').style.inlineSize = `${(100 * r.interest) / r.total}%`;
    };
    // מפריד אלפים בשדות סכום — ביציאה מהשדה (לא בזמן הקלדה, כדי לא להזיז את הסמן)
    form.querySelectorAll<HTMLInputElement>('input[data-num]').forEach((el) => {
      el.addEventListener('blur', () => {
        const v = parseFloat(el.value.replace(/[^\d.]/g, ''));
        if (!isNaN(v) && el.dataset.num !== 'dec') el.value = nf.format(v);
      });
    });
    form.addEventListener('input', render);
    form.addEventListener('submit', (e) => e.preventDefault());
    render();
  }


